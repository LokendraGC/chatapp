generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(dbgenerated("gen_random_uuid()"))
  organization_id String
  name            String?
  email           String   @unique
  image           String?
  created_at      DateTime @default(now())

  @@map("user")
}

model MetaData {
  id             String   @id @default(dbgenerated("gen_random_uuid()"))
  user_email     String   @unique
  business_name  String
  website_url    String
  external_links String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@map("metadata")
}

model KnowledgeSource {
  id           String   @id @default(dbgenerated("gen_random_uuid()"))
  user_email   String
  type         String
  name         String
  status       String   @default("active")
  source_url   String?
  content      String?
  meta_data    String?
  last_updated DateTime @default(now()) @updatedAt
  created_at   DateTime @default(now())

  @@map("knowledge_source")
}

model Section {
  id             String   @id @default(dbgenerated("gen_random_uuid()"))
  user_email     String
  name           String
  description    String
  tone           String
  allowed_topics String?
  blocked_topics String?
  status         String   @default("draft")
  source_ids     String[]
  created_at     DateTime @default(now())

  @@map("section")
}

model ChatBotMetadata {
  id              String   @id @default(dbgenerated("gen_random_uuid()"))
  user_email      String   @unique
  color           String?  @default("#4f39f6")
  welcome_message String?  @default("Hi there, How can I help you today?")
  created_at      DateTime @default(now())

  @@map("chatbot_metadata")
}

model TeamMember {
  id                  String  @id @default(dbgenerated("gen_random_uuid()"))
  user_email          String  @unique
  name                String?
  organization_id     String
  image               String?
  clerk_invitation_id String?
  clerk_user_id       String?
  status     String?  @default("active")
  role       String?  @default("user")
  created_at DateTime @default(now())

  @@map("team_member")
}
